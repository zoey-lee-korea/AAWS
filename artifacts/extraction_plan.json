{
  "goal": "quotes.toscrape.com 1~2페이지에서 명언(text, author, tags)을 수집하여 artifacts/data/quotes_multiagent.json에 저장",
  "output_schema": {
    "text": "string (명언 내용)",
    "author": "string (작가명)",
    "tags": "list of strings (태그 배열)"
  },
  "data_sources": [
    {
      "description": "quotes.toscrape.com 명언 목록",
      "method": "css_selectors",
      "details": {
        "container": "div.quote",
        "fields": {
          "text": "span.text",
          "author": "small.author",
          "tags": "div.tags a.tag"
        }
      }
    }
  ],
  "navigation": "http://quotes.toscrape.com/ 및 http://quotes.toscrape.com/page/2/",
  "concerns": "정적 HTML 사이트로 차단 및 봇 감지 위험 낮음"
}