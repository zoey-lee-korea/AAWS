{
  "goal": "quotes.toscrape.com 1, 2페이지 명언, 저자, 태그 데이터 수집",
  "output_schema": {
    "text": "string (명언 본문)",
    "author": "string (저자 이름)",
    "tags": "list of string (태그 목록)"
  },
  "data_sources": [
    {
      "description": "HTML CSS 셀렉터를 통한 명언 블록 추출",
      "method": "css_selectors",
      "details": {
        "container": "div.quote",
        "fields": {
          "text": "span.text",
          "author": "small.author",
          "tags": "div.tags a.tag"
        }
      }
    }
  ],
  "navigation": "http://quotes.toscrape.com/page/1/ 및 http://quotes.toscrape.com/page/2/",
  "concerns": "정적 HTML 사이트이므로 requests / BeautifulSoup 또는 httpx / asyncio를 이용한 비동기 스크래핑 가능"
}